<!-- this is the main window of the whole app, everything lives in here -->
<!-- xmlns namespaces: default WPF controls, x: for XAML utilities, d: for design-time, mc: for markup compat -->
<!-- catppuccin mocha theme: dark bg (#1e1e2e), light text (#cdd6f4), drag and drop enabled -->
<Window x:Class="AutoRepairGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AutoRepair — Automated C# Bug Repair"
        Height="820" Width="1050" MinHeight="700" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e" Foreground="#cdd6f4"
        AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <!-- all our color brushes defined here so we can reference them by name everywhere -->
        <SolidColorBrush x:Key="AccentBrush"   Color="#89b4fa"/>  <!-- blue, used for highlights and the main accent color -->
        <SolidColorBrush x:Key="GreenBrush"    Color="#a6e3a1"/>  <!-- green, used for success states -->
        <SolidColorBrush x:Key="RedBrush"      Color="#f38ba8"/>  <!-- red, used for errors and failures -->
        <SolidColorBrush x:Key="YellowBrush"   Color="#f9e2af"/>  <!-- yellow, used for warnings and running states -->
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#313244"/>  <!-- slightly lighter dark, used for card backgrounds -->
        <SolidColorBrush x:Key="Surface2Brush" Color="#45475a"/>  <!-- even lighter, used for borders and dividers -->
        <SolidColorBrush x:Key="TextBrush"     Color="#cdd6f4"/>  <!-- main text color, light grayish white -->
        <SolidColorBrush x:Key="SubtextBrush"  Color="#a6adc8"/>  <!-- dimmer text for less important stuff like subtitles -->
        <SolidColorBrush x:Key="OldCodeBg"     Color="#3b1d1e"/>  <!-- dark red background for original code in diffs -->
        <SolidColorBrush x:Key="NewCodeBg"     Color="#1d3b2a"/>  <!-- dark green background for patched code in diffs -->

        <!-- reusable style for the step indicator cards so we dont repeat ourselves -->
        <Style x:Key="StepBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>                                     <!-- rounded corners on the cards -->
            <Setter Property="Padding" Value="14,10"/>                                      <!-- some breathing room inside the card -->
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>           <!-- dark card background -->
            <Setter Property="BorderThickness" Value="2"/>                                  <!-- border width around each card -->
            <Setter Property="BorderBrush" Value="{StaticResource Surface2Brush}"/>         <!-- default border color, changes when step runs -->
        </Style>
    </Window.Resources>

    <!-- the main layout grid, everything is arranged in rows -->
    <Grid Margin="18"> <!-- 18px margin around the edges so stuff isnt right against the window border -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- row 0: title, sizes to fit its content -->
            <RowDefinition Height="Auto"/>   <!-- row 1: the drop zone area -->
            <RowDefinition Height="Auto"/>   <!-- row 2: shows detected project info after dropping -->
            <RowDefinition Height="Auto"/>   <!-- row 3: the three step indicator cards -->
            <RowDefinition Height="*"/>      <!-- row 4: takes up all remaining space for the tabbed content -->
            <RowDefinition Height="Auto"/>   <!-- row 5: buttons at the bottom -->
        </Grid.RowDefinitions>

        <!-- title section at the top of the window -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12"> <!-- stacks title and subtitle vertically -->
            <TextBlock Text="⚙  AutoRepair Pipeline" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>  <!-- big blue title text -->
            <TextBlock Text="Drag &amp; drop a C# project folder or .csproj file to begin"
                       FontSize="13" Foreground="{StaticResource SubtextBrush}" Margin="0,4,0,0"/> <!-- instruction subtitle in dimmer color -->
        </StackPanel>

        <!-- the drag and drop zone, also clickable to browse for files -->
        <Border x:Name="DropZone" Grid.Row="1" CornerRadius="12" Padding="28"
                Background="#181825" BorderThickness="2" BorderBrush="{StaticResource Surface2Brush}"
                Margin="0,0,0,12" Cursor="Hand"
                MouseLeftButtonUp="DropZone_Click"> <!-- clicking it opens a file dialog -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"> <!-- centered content inside the drop zone -->
                <TextBlock x:Name="DropIcon" Text="📂" FontSize="36" HorizontalAlignment="Center"/> <!-- folder emoji, changes to checkmark after drop -->
                <TextBlock x:Name="DropText" Text="Drop C# project here  (or click to browse)"
                           FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{StaticResource SubtextBrush}"/> <!-- instructions, gets replaced with project name after drop -->
            </StackPanel>
        </Border>

        <!-- this panel shows the detected source dir and test project after you drop something -->
        <!-- starts out collapsed (hidden) and becomes visible once a project is loaded -->
        <Border Grid.Row="2" CornerRadius="8" Padding="12,8" Background="{StaticResource SurfaceBrush}"
                Margin="0,0,0,12" Visibility="Collapsed" x:Name="InfoPanel">
            <Grid> <!-- using a grid here so we can line up the labels and values nicely -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- column for the "Source:" and "Tests:" labels -->
                    <ColumnDefinition Width="*"/>     <!-- column for the actual paths, stretches to fill -->
                    <ColumnDefinition Width="Auto"/>  <!-- column for the browse button -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/> <!-- row for source directory -->
                    <RowDefinition/> <!-- row for test project -->
                </Grid.RowDefinitions>
                <!-- source directory label and value -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Source: " FontWeight="SemiBold" Foreground="{StaticResource SubtextBrush}" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LblSourceDir" Text="" Foreground="{StaticResource TextBrush}" Margin="4,2" TextTrimming="CharacterEllipsis"/> <!-- shows the path, trims with ... if too long -->
                <!-- test project label, value and browse button -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tests:   " FontWeight="SemiBold" Foreground="{StaticResource SubtextBrush}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LblTestProject" Text="" Foreground="{StaticResource TextBrush}" Margin="4,2" TextTrimming="CharacterEllipsis"/> <!-- test project path goes here -->
                <Button Grid.Row="1" Grid.Column="2" x:Name="BtnBrowseTests" Content="Browse…" Click="BtnBrowseTests_Click"
                        Padding="10,2" Margin="6,0,0,0" FontSize="11" Cursor="Hand"
                        Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}" BorderThickness="0"/> <!-- lets you manually pick a test project -->
            </Grid>
        </Border>

        <!-- three step indicator cards lined up horizontally using UniformGrid -->
        <!-- each card shows the status of one pipeline step (tracing, constraints, repair) -->
        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,12"> <!-- 3 columns = 3 equal-width cards -->
            <!-- step 1 card: tracing -->
            <Border x:Name="Step1Border" Style="{StaticResource StepBorder}" Margin="0,0,6,0"> <!-- uses the shared step style, gap on the right -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal"> <!-- icon and label side by side -->
                        <TextBlock x:Name="Step1Icon" Text="○" FontSize="16" Foreground="{StaticResource SubtextBrush}" VerticalAlignment="Center"/> <!-- circle icon, changes to hourglass/check/x -->
                        <TextBlock Text="  Step 1: Tracing" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/> <!-- step name -->
                    </StackPanel>
                    <TextBlock x:Name="Step1Status" Text="Waiting" FontSize="11" Foreground="{StaticResource SubtextBrush}" Margin="22,4,0,0"/> <!-- status text like "Waiting", "Running...", "Complete" -->
                </StackPanel>
            </Border>
            <!-- step 2 card: constraints analysis -->
            <Border x:Name="Step2Border" Style="{StaticResource StepBorder}" Margin="3,0,3,0"> <!-- gap on both sides -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Step2Icon" Text="○" FontSize="16" Foreground="{StaticResource SubtextBrush}" VerticalAlignment="Center"/> <!-- same pattern as step 1 -->
                        <TextBlock Text="  Step 2: Constraints" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="Step2Status" Text="Waiting" FontSize="11" Foreground="{StaticResource SubtextBrush}" Margin="22,4,0,0"/>
                </StackPanel>
            </Border>
            <!-- step 3 card: repair/patch generation -->
            <Border x:Name="Step3Border" Style="{StaticResource StepBorder}" Margin="6,0,0,0"> <!-- gap on the left -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Step3Icon" Text="○" FontSize="16" Foreground="{StaticResource SubtextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="  Step 3: Repair" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="Step3Status" Text="Waiting" FontSize="11" Foreground="{StaticResource SubtextBrush}" Margin="22,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- the main content area with two tabs: log output and patch review -->
        <TabControl x:Name="MainTabs" Grid.Row="4" Margin="0,0,0,12"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextBrush}"> <!-- transparent background so it blends with our dark theme -->
            <TabControl.Resources>
                <!-- custom style for the tab headers so they match our dark theme -->
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/> <!-- dark tab background -->
                    <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/> <!-- dimmer text when not selected -->
                    <Setter Property="Padding" Value="14,6"/>  <!-- padding inside each tab header -->
                    <Setter Property="FontSize" Value="13"/>   <!-- tab header font size -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- completely replacing the default tab look with our own -->
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}"
                                        Margin="0,0,2,0" BorderThickness="0"> <!-- rounded top corners, flat bottom -->
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/> <!-- puts the tab header text inside -->
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- when this tab is selected, make it look different -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#181825"/> <!-- darker background for active tab -->
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/> <!-- blue text for active tab -->
                                        <Setter Property="FontWeight" Value="SemiBold"/> <!-- bold text for active tab -->
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- first tab: shows the real-time output log from the pipeline -->
            <TabItem Header="📋  Output Log">
                <Border CornerRadius="0,8,8,8" Background="#11111b" Padding="2"> <!-- rounded bottom corners, very dark bg -->
                    <ScrollViewer x:Name="OutputScroller" VerticalScrollBarVisibility="Auto"> <!-- scrollbar shows when needed -->
                        <TextBox x:Name="OutputLog" Background="Transparent" Foreground="#cdd6f4"
                                 FontFamily="Cascadia Mono,Consolas,Courier New" FontSize="12"
                                 IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                 Padding="10,8" VerticalScrollBarVisibility="Disabled"
                                 Text="Ready. Drop a project to start the pipeline.&#x0a;"/> <!-- monospace font, read-only, starts with a ready message -->
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- second tab: shows the generated patches for review before applying -->
            <TabItem Header="🔍  Patch Review" x:Name="TabPatchReview">
                <Border CornerRadius="0,8,8,8" Background="#11111b" Padding="6"> <!-- same rounded style as the log tab -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- summary bar at top -->
                            <RowDefinition Height="*"/>    <!-- scrollable patch cards take the rest -->
                        </Grid.RowDefinitions>

                        <!-- summary bar that says how many patches were found -->
                        <Border Grid.Row="0" CornerRadius="6" Background="{StaticResource SurfaceBrush}"
                                Padding="12,8" Margin="0,0,0,8">
                            <TextBlock x:Name="PatchSummary" Text="No patches generated yet."
                                       FontSize="13" Foreground="{StaticResource SubtextBrush}"/> <!-- updates with patch count after step 3 -->
                        </Border>

                        <!-- scrollable list of patch cards, each one shows a diff -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PatchList"> <!-- this is like a repeater, it creates one card per patch -->
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate> <!-- this template defines what each patch card looks like -->
                                        <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource Surface2Brush}" BorderThickness="1"
                                                Padding="14" Margin="0,0,0,10"> <!-- each card is a rounded bordered box with spacing below -->
                                            <StackPanel>
                                                <!-- top row of the card: file name, line number, and which rule triggered it -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding File}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}" FontSize="13"/> <!-- file name in blue -->
                                                    <TextBlock Text=" : " Foreground="{StaticResource SubtextBrush}"/>   <!-- separator -->
                                                    <TextBlock Text="{Binding LineLabel}" Foreground="{StaticResource YellowBrush}" FontSize="13"/> <!-- line number in yellow -->
                                                    <TextBlock Text="  │  " Foreground="{StaticResource Surface2Brush}"/>  <!-- vertical bar separator -->
                                                    <TextBlock Text="{Binding RuleName}" Foreground="{StaticResource SubtextBrush}"
                                                               FontStyle="Italic" FontSize="12"/> <!-- rule name in italics -->
                                                </StackPanel>

                                                <!-- description of what the patch does -->
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextBrush}" FontSize="12"
                                                           Margin="0,0,0,10"/> <!-- wraps if the description is long -->

                                                <!-- the original code section (red-ish background like a git diff) -->
                                                <TextBlock Text="─  Original" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#f38ba8" Margin="0,0,0,3"/> <!-- red label -->
                                                <Border CornerRadius="4" Background="#2d1517" Padding="10,8"
                                                        Margin="0,0,0,8" BorderBrush="#5c2225" BorderThickness="1"> <!-- dark red box -->
                                                    <TextBlock Text="{Binding OriginalCode}" TextWrapping="Wrap"
                                                               FontFamily="Cascadia Mono,Consolas,Courier New"
                                                               FontSize="12" Foreground="#f5c2c7"/> <!-- shows the old code in monospace pink-ish text -->
                                                </Border>

                                                <!-- the patched code section (green-ish background) -->
                                                <TextBlock Text="+  Patched" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#a6e3a1" Margin="0,0,0,3"/> <!-- green label -->
                                                <Border CornerRadius="4" Background="#152d1d" Padding="10,8"
                                                        BorderBrush="#225c3b" BorderThickness="1"> <!-- dark green box -->
                                                    <TextBlock Text="{Binding PatchedCode}" TextWrapping="Wrap"
                                                               FontFamily="Cascadia Mono,Consolas,Courier New"
                                                               FontSize="12" Foreground="#c7f5d5"/> <!-- shows the new code in monospace greenish text -->
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- all the action buttons at the bottom right of the window -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"> <!-- lined up horizontally, pushed to the right -->
            <!-- clear log button, always visible -->
            <Button x:Name="BtnClear" Content="Clear Log" Click="BtnClear_Click"
                    Width="100" Height="34" Margin="0,0,8,0"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                    BorderThickness="0" FontSize="13" Cursor="Hand"/> <!-- plain dark button -->
            <!-- cancel button, only enabled while pipeline is running -->
            <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                    Width="100" Height="34" Margin="0,0,8,0" IsEnabled="False"
                    Background="{StaticResource RedBrush}" Foreground="#1e1e2e"
                    BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/> <!-- red button, disabled by default -->
            <!-- reject patches button, hidden until patches are ready for review -->
            <Button x:Name="BtnReject" Content="✘  Reject Patches" Click="BtnReject_Click"
                    Width="150" Height="34" Margin="0,0,8,0" Visibility="Collapsed"
                    Background="{StaticResource RedBrush}" Foreground="#1e1e2e"
                    BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/> <!-- collapsed = completely hidden, not just invisible -->
            <!-- apply patches button, also hidden until patches are ready -->
            <Button x:Name="BtnApply" Content="✔  Apply Patches" Click="BtnApply_Click"
                    Width="150" Height="34" Margin="0,0,8,0" Visibility="Collapsed"
                    Background="{StaticResource GreenBrush}" Foreground="#1e1e2e"
                    BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/> <!-- green button for applying -->
            <!-- the main run button, disabled until a test project is set -->
            <Button x:Name="BtnRun" Content="▶  Run Pipeline" Click="BtnRun_Click"
                    Width="150" Height="34" IsEnabled="False"
                    Background="{StaticResource AccentBrush}" Foreground="#1e1e2e"
                    BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/> <!-- blue accent button, the primary action -->
        </StackPanel>
    </Grid>
</Window>
